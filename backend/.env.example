# BotForg backend — copy to backend/.env (gitignored).
# Generate secrets: openssl rand -hex 32
# Dev ports: docs/DEV_PORTS.md (backend default 8000, frontend 5173)

# --- JWT (REQUIRED in production) ---
SECRET_KEY=CHANGE_ME_REQUIRED_MIN_32_CHARS_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_SECRET=CHANGE_ME_REQUIRED_DIFFERENT_FROM_SECRET_KEY_OPENSSL_RAND_HEX_32
SESSION_SECRET=CHANGE_ME_OPTIONAL_BUT_RECOMMENDED_OPENSSL_RAND_HEX_32
ENVIRONMENT=development

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=

# --- Frontend / CORS ---
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Email (optional) ---
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BotForg <noreply@example.local>
# Admin/ops email for refund user-reply notifications (optional)
REFUND_ADMIN_NOTIFY_EMAIL=

# --- Notification outbox worker (6.14.10B) ---
NOTIFICATION_OUTBOX_BATCH_SIZE=20
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=8
NOTIFICATION_OUTBOX_BASE_RETRY_SECONDS=30
NOTIFICATION_OUTBOX_LEASE_SECONDS=300
NOTIFICATION_TEMPLATE_VERSION=v1

# --- Database ---
DATABASE_URL=sqlite:///./botforg.db

# --- 152-FZ (required in production RU) ---
DATA_REGION=
STORAGE_REGION=
CHAT_HASH_SALT=

# --- Redis (optional) ---
REDIS_URL=redis://localhost:6379/0
STRICT_REDIS=false

# --- MAX channel ---
MAX_API_BASE=https://platform-api.max.ru
MAX_WEBHOOK_BASE_URL=

# --- WhatsApp (Graph API base, optional override) ---
WHATSAPP_GRAPH_API_BASE=https://graph.facebook.com/v19.0

# --- Payment providers (optional) ---
# Abstraction (stage 6.8): choose provider by name; secrets stay in env only.
PAYMENT_PROVIDER_DEFAULT=yookassa
PAYMENT_PROVIDERS_AVAILABLE=yookassa
PAYMENT_PROVIDER_TEST_MODE=false
# Fake provider for automated tests — NEVER enable in production
ALLOW_FAKE_PAYMENT_PROVIDER=false

# Encrypted credentials for PaymentProviderConnection (stages 6.10A / 6.10B)
# REQUIRED in development and production (fail-closed). Never auto-generate at runtime.
# Generate a permanent local key once and keep it in backend/.env (gitignored):
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
# NEVER commit a real key. Without this key, creating a payment connection returns 503.
PAYMENT_CREDENTIALS_MASTER_KEY=
PAYMENT_CREDENTIALS_KEY_ID=default
PAYMENT_CREDENTIALS_ENCRYPTION_VERSION=1

TELEGRAM_PAYMENT_PROVIDER_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_REDIRECT_URL=https://example.com/payment/success
# Dev/test only — never enable in production (startup exits if true in production)
YOOKASSA_WEBHOOK_SKIP_IP_CHECK=false
# Opt-in: trust X-Forwarded-For / X-Real-IP only from peers in TRUSTED_PROXIES
YOOKASSA_WEBHOOK_TRUST_PROXY=false
# Comma-separated IPs/CIDRs of reverse proxies (required if TRUST_PROXY=true in production)
YOOKASSA_WEBHOOK_TRUSTED_PROXIES=
PAYMENT_PROVIDER_HTTP_TIMEOUT_SEC=15
STRIPE_API_KEY=
STRIPE_SUCCESS_URL=https://example.com/success
STRIPE_CANCEL_URL=https://example.com/cancel
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_SECRET_KEY=
CLOUDPAYMENTS_PAYMENT_URL=
CLOUDPAYMENTS_SUCCESS_URL=https://example.com/success
CLOUDPAYMENTS_FAIL_URL=https://example.com/fail

# --- AI integrations (optional) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Runtime flags ---
DEBUG=false
ALLOW_DOCS=true
TESTING=false
# Mock POST /me/plan and PATCH /billing/quota — NEVER enable in production
ALLOW_DEV_TARIFF_FULFILLMENT=false
