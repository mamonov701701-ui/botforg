# BotForg frontend — copy to .env.development for local dev (gitignored).
#
# Vite dev (npm run dev): API calls use relative paths + Vite proxy (see docs/DEV_PORTS.md).
# VITE_API_URL is used for production build / preview when API is on another host.
#
# Backend dev port (must match uvicorn): 8000

VITE_API_URL=http://localhost:8000
