# =============================================
# BotForg — шаблон продакшн конфигурации
# Скопируй в .env и заполни все значения
# Генерация секретов: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================

# --- ОБЯЗАТЕЛЬНО ---

# База данных PostgreSQL (SQLite не подходит для прода — нет CRM агрегатов и фоновых задач)
DATABASE_URL=postgresql://botforg_user:REPLACE_PASSWORD@localhost:5432/botforg

# Redis (нужен для rate limiting между воркерами и фоновых задач)
REDIS_URL=redis://localhost:6379/0

# Секреты (ОБЯЗАТЕЛЬНО сгенерировать новые, не использовать из примеров)
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX
JWT_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX

# Соль для хеширования chat_id (152-ФЗ — chat_id не хранится в открытом виде)
CHAT_HASH_SALT=REPLACE_WITH_64_CHAR_HEX

# Регионы хранения данных (152-ФЗ — обязательно RU для работы в России)
DATA_REGION=RU
STORAGE_REGION=RU

# Режим работы
ENVIRONMENT=production
DEBUG=false
TESTING=false
ALLOW_DOCS=false

# URL фронтенда (твой реальный домен)
FRONTEND_ORIGIN=https://YOUR_DOMAIN
FRONTEND_URL=https://YOUR_DOMAIN

# --- КАНАЛЫ ---

# MAX (обязателен публичный HTTPS домен для webhook)
MAX_WEBHOOK_BASE_URL=https://YOUR_DOMAIN
# MAX_API_BASE=https://platform-api.max.ru  # менять не нужно

# Telegram (токен берётся из настроек каждого бота отдельно, здесь не нужен)

# --- ОПЦИОНАЛЬНО ---

# Email верификация
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BotForg <noreply@YOUR_DOMAIN>
REQUIRE_EMAIL_VERIFICATION=true

# OAuth провайдеры
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=

# Платёжные системы
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
STRIPE_API_KEY=
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_SECRET_KEY=

# Мониторинг
SENTRY_DSN=

# =============================================
# КАК РАЗВЕРНУТЬ НА PostgreSQL
#
# 1. Установи PostgreSQL и создай БД:
#    createuser botforg_user
#    createdb botforg --owner botforg_user
#    psql -c "ALTER USER botforg_user PASSWORD 'REPLACE_PASSWORD';"
#
# 2. Заполни DATABASE_URL выше реальными данными
#
# 3. Примени миграции:
#    alembic upgrade head
#
# 4. Проверь подключение:
#    curl http://localhost:8000/ready
#
# 5. Запусти с несколькими воркерами:
#    uvicorn backend.main:app --workers 4 --port 8000
# =============================================
