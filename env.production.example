# BotForg Production Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED - Must be set for production
# ============================================

# JWT Secrets (generate with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-min-32-chars-here
JWT_SECRET=your-jwt-secret-key-min-32-chars-here

# Database (PostgreSQL)
POSTGRES_USER=botforg
POSTGRES_PASSWORD=your-strong-postgres-password
POSTGRES_DB=botforg
DATABASE_URL=postgresql://botforg:your-strong-postgres-password@postgres:5432/botforg

# Redis
REDIS_PASSWORD=your-strong-redis-password
REDIS_URL=redis://:your-strong-redis-password@redis:6379/0

# ============================================
# FRONTEND URLs
# ============================================
FRONTEND_ORIGIN=https://botforg.app
FRONTEND_URL=https://botforg.app

# ============================================
# OAUTH PROVIDERS (Optional)
# ============================================

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yandex OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Mail.ru OAuth
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=

# ============================================
# EMAIL SETTINGS (Optional, for email verification)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=BotForg <noreply@botforg.app>
REQUIRE_EMAIL_VERIFICATION=true

# ============================================
# PAYMENT PROVIDERS (Optional)
# ============================================

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_REDIRECT_URL=https://botforg.app/payment/callback

# Stripe
STRIPE_API_KEY=
STRIPE_SUCCESS_URL=https://botforg.app/payment/success
STRIPE_CANCEL_URL=https://botforg.app/payment/cancel

# CloudPayments
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_SECRET_KEY=

# ============================================
# TELEGRAM (Optional)
# ============================================
TELEGRAM_PAYMENT_PROVIDER_TOKEN=

# ============================================
# MONITORING (Optional)
# ============================================
SENTRY_DSN=

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=production
DEBUG=false
TESTING=false

