# BotForg Production Environment Variables
# Copy to .env (e.g. /opt/botforg/.env) and fill in values.
# ОБЯЗАТЕЛЬНЫ ДЛЯ PROD В РФ: JWT_SECRET, CHAT_HASH_SALT, DATA_REGION=RU, STORAGE_REGION=RU, DEBUG=false

# ============================================
# REQUIRED - Must be set for production
# ============================================

# JWT Secrets (generate with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-min-32-chars-here
JWT_SECRET=your-jwt-secret-key-min-32-chars-here

# Database — задаётся через env. Допускается SQLite временно (файл в хранилище в РФ).
# Пример PostgreSQL: postgresql://user:pass@host:5432/botforg
DATABASE_URL=sqlite:////opt/botforg/data/botforg.db

# ============================================
# FRONTEND URLs (подставьте свой домен)
# ============================================
FRONTEND_ORIGIN=https://YOUR_DOMAIN
FRONTEND_URL=https://YOUR_DOMAIN

# MAX (platform-api.max.ru): для подписки webhook нужен публичный HTTPS-домен.
# Без MAX_WEBHOOK_BASE_URL в prod нельзя включить канал MAX.
# MAX_API_BASE=https://platform-api.max.ru
MAX_WEBHOOK_BASE_URL=https://YOUR_DOMAIN

# ============================================
# OAUTH PROVIDERS (Optional)
# ============================================

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yandex OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Mail.ru OAuth
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=

# ============================================
# EMAIL SETTINGS (Optional, for email verification)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=BotForg <noreply@botforg.app>
REQUIRE_EMAIL_VERIFICATION=true

# ============================================
# PAYMENT PROVIDERS (Optional)
# ============================================

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_REDIRECT_URL=https://botforg.app/payment/callback

# Stripe
STRIPE_API_KEY=
STRIPE_SUCCESS_URL=https://botforg.app/payment/success
STRIPE_CANCEL_URL=https://botforg.app/payment/cancel

# CloudPayments
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_SECRET_KEY=

# ============================================
# TELEGRAM (Optional)
# ============================================
TELEGRAM_PAYMENT_PROVIDER_TOKEN=

# ============================================
# MONITORING (Optional)
# ============================================
SENTRY_DSN=

# ============================================
# 152-ФЗ — ОБЯЗАТЕЛЬНО для prod в РФ
# ============================================
DATA_REGION=RU
STORAGE_REGION=RU
# Секрет для HMAC chat_hash (обязателен; chat_id в БД не хранится). Генерация: openssl rand -hex 32
CHAT_HASH_SALT=your-chat-hash-salt-use-openssl-rand-hex-32

# ============================================
# ENVIRONMENT (prod: DEBUG должен быть false)
# ALLOW_DOCS: при ENVIRONMENT=production по умолчанию false — /docs, /redoc, /openapi.json отдают 404
# ============================================
ENVIRONMENT=production
DEBUG=false
# ALLOW_DOCS=true
TESTING=false

