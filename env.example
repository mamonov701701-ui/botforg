# JWT settings (REQUIRED - generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_REQUIRED_MIN_32_CHARACTERS_USE_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OAuth JWT settings (for session cookies) (REQUIRED - different from SECRET_KEY)
JWT_SECRET=CHANGE_ME_REQUIRED_DIFFERENT_FROM_SECRET_KEY_USE_OPENSSL_RAND_HEX_32
# Optional: Separate session secret (recommended for security)
SESSION_SECRET=OPTIONAL_BUT_RECOMMENDED_ANOTHER_32_CHARS_OPENSSL_RAND_HEX_32
ENVIRONMENT=development

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=

# CORS settings
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email/Password Auth
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BotForg <noreply@botforg.app>

# Database
DATABASE_URL=sqlite:///./botforg.db

# 152-ФЗ: для production в РФ обязательно DATA_REGION=RU, STORAGE_REGION=RU, CHAT_HASH_SALT
DATA_REGION=
STORAGE_REGION=
# Секрет для HMAC-хеша чата (обязателен в prod; chat_id в БД не хранится)
CHAT_HASH_SALT=

# Payment providers (optional)
TELEGRAM_PAYMENT_PROVIDER_TOKEN=your_telegram_token_here
YOOKASSA_SHOP_ID=your_yookassa_shop_id
YOOKASSA_SECRET_KEY=your_yookassa_secret_key
YOOKASSA_REDIRECT_URL=https://your-site.com/success
STRIPE_API_KEY=your_stripe_secret_key
STRIPE_SUCCESS_URL=https://your-site.com/success
STRIPE_CANCEL_URL=https://your-site.com/cancel
CLOUDPAYMENTS_PUBLIC_ID=your_cloudpayments_public_id
CLOUDPAYMENTS_SECRET_KEY=your_cloudpayments_secret_key
CLOUDPAYMENTS_PAYMENT_URL=https://api.cloudpayments.ru/payments/cards/charge
CLOUDPAYMENTS_SUCCESS_URL=https://your-site.com/success
CLOUDPAYMENTS_FAIL_URL=https://your-site.com/fail
